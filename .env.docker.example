# Optional Docker settings. Default startup needs no env file:
#   docker compose up -d --build
# To customize: copy to .env.docker, then use:
#   docker compose --env-file .env.docker up -d --build
STUDYHUB_HOST=127.0.0.1
STUDYHUB_PORT=8082
STUDYHUB_URL=http://localhost:8082
# Optional after the GitHub image workflow publishes successfully:
# STUDYHUB_IMAGE=ghcr.io/oxidized-elias/studyhub:latest
# Optional existing host vault. Create it first and ensure it is writable by the image UID/GID.
# Inside StudyHub this folder is always /vault.
# STUDYHUB_VAULT_PATH=/home/your-user/Documents/StudyHub_Vault
# Optional image build UID/GID for host bind mounts (use `id -u` and `id -g`).
STUDYHUB_UID=1000
STUDYHUB_GID=1000

# Default for bridge networking; compose.host.yaml defaults to 127.0.0.1 instead.
# STUDYHUB_OLLAMA_URL=http://host.docker.internal:11434
