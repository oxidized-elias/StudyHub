# Node does not automatically read .env. Use: node --env-file=.env server.mjs --release
STUDYHUB_BIND=127.0.0.1:8082
# Absolute paths or paths relative to this repository:
DATA_DIR=./data
# Defaults to DATA_DIR/vault; set an absolute host path for Obsidian if desired.
# VAULT_DIR=/path/to/StudyHub_Vault
# Optional HTTP Basic authentication. Use HTTPS at your reverse proxy.
# STUDYHUB_USER=admin
# STUDYHUB_PASSWORD=replace-with-your-password
# Optional public URL for links when using a reverse proxy:
# STUDYHUB_URL=https://study.example.com
